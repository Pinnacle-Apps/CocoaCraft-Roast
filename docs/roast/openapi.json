  "components": {
    "schemas": {
      "CacaoMetadata": {
        "properties": {
          "origin": {
            "type": "string",
            "maxLength": 200,
            "title": "Origin",
            "default": ""
          },
          "lot": {
            "type": "string",
            "maxLength": 200,
            "title": "Lot",
            "default": ""
          },
          "bean_form": {
            "type": "string",
            "enum": [
              "whole",
              "nib",
              "unknown"
            ],
            "title": "Bean Form",
            "default": "unknown"
          },
          "fermentation": {
            "type": "string",
            "maxLength": 200,
            "title": "Fermentation",
            "default": ""
          },
          "moisture_percent": {
            "anyOf": [
              {
                "type": "number",
                "maximum": 100.0,
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Moisture Percent"
          },
          "beans_per_100g": {
            "anyOf": [
              {
                "type": "number",
                "exclusiveMinimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Beans Per 100G"
          },
          "batch_mass_kg": {
            "anyOf": [
              {
                "type": "number",
                "exclusiveMinimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Batch Mass Kg"
          },
          "output_mass_kg": {
            "anyOf": [
              {
                "type": "number",
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Output Mass Kg"
          },
          "roaster": {
            "type": "string",
            "maxLength": 200,
            "title": "Roaster",
            "default": ""
          },
          "probe_location": {
            "type": "string",
            "maxLength": 300,
            "title": "Probe Location",
            "default": ""
          },
          "sensory_notes": {
            "type": "string",
            "maxLength": 4000,
            "title": "Sensory Notes",
            "default": ""
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "CacaoMetadata"
      },
      "EngineSettings": {
        "properties": {
          "delta_samples": {
            "type": "integer",
            "maximum": 120.0,
            "minimum": 1.0,
            "title": "Delta Samples",
            "default": 5
          },
          "ror_method": {
            "type": "string",
            "enum": [
              "artisan_simple",
              "artisan_polyfit"
            ],
            "title": "Ror Method",
            "default": "artisan_simple"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "EngineSettings"
      },
      "Event": {
        "properties": {
          "elapsed_seconds": {
            "type": "number",
            "title": "Elapsed Seconds"
          },
          "kind": {
            "type": "string",
            "enum": [
              "charge",
              "drop",
              "cooling_end",
              "observation",
              "control_change",
              "artisan_marker"
            ],
            "title": "Kind"
          },
          "label": {
            "type": "string",
            "maxLength": 120,
            "minLength": 1,
            "title": "Label"
          },
          "notes": {
            "type": "string",
            "maxLength": 2000,
            "title": "Notes",
            "default": ""
          },
          "original_marker": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Original Marker"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "elapsed_seconds",
          "kind",
          "label"
        ],
        "title": "Event"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "ImportRequest": {
        "properties": {
          "profile_text": {
            "type": "string",
            "maxLength": 1000000,
            "title": "Profile Text"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "profile_text"
        ],
        "title": "ImportRequest"
      },
      "ProductionLink": {
        "properties": {
          "production_run_id": {
            "type": "string",
            "format": "uuid",
            "title": "Production Run Id"
          },
          "step_id": {
            "anyOf": [
              {
                "type": "string",
                "format": "uuid"
              },
              {
                "type": "null"
              }
            ],
            "title": "Step Id"
          },
          "machine_run_id": {
            "anyOf": [
              {
                "type": "string",
                "format": "uuid"
              },
              {
                "type": "null"
              }
            ],
            "title": "Machine Run Id"
          },
          "adapter": {
            "type": "string",
            "enum": [
              "mock",
              "cocoacraft"
            ],
            "title": "Adapter",
            "default": "mock"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "production_run_id"
        ],
        "title": "ProductionLink"
      },
      "RoastSession": {
        "properties": {
          "schema_version": {
            "type": "string",
            "const": "1.0",
            "title": "Schema Version",
            "default": "1.0"
          },
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "owner_user_id": {
            "type": "string",
            "format": "uuid",
            "title": "Owner User Id"
          },
          "name": {
            "type": "string",
            "maxLength": 160,
            "minLength": 1,
            "title": "Name",
            "default": "Untitled cacao roast"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At"
          },
          "temperature_unit": {
            "type": "string",
            "enum": [
              "C",
              "F"
            ],
            "title": "Temperature Unit",
            "default": "C"
          },
          "production_link": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ProductionLink"
              },
              {
                "type": "null"
              }
            ]
          },
          "metadata": {
            "$ref": "#/components/schemas/CacaoMetadata"
          },
          "samples": {
            "items": {
              "$ref": "#/components/schemas/Sample"
            },
            "type": "array",
            "maxItems": 10000,
            "title": "Samples"
          },
          "events": {
            "items": {
              "$ref": "#/components/schemas/Event"
            },
            "type": "array",
            "maxItems": 500,
            "title": "Events"
          },
          "settings": {
            "$ref": "#/components/schemas/EngineSettings"
          },
          "source_kind": {
            "type": "string",
            "enum": [
              "manual",
              "artisan_import",
              "mock_replay",
              "reference_copy"
            ],
            "title": "Source Kind",
            "default": "manual"
          },
          "source_profile_text": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 1000000
              },
              {
                "type": "null"
              }
            ],
            "title": "Source Profile Text"
          },
          "reference_profile_id": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 160
              },
              {
                "type": "null"
              }
            ],
            "title": "Reference Profile Id"
          },
          "notes": {
            "type": "string",
            "maxLength": 8000,
            "title": "Notes",
            "default": ""
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "owner_user_id"
        ],
        "title": "RoastSession"
      },
      "Sample": {
        "properties": {
          "elapsed_seconds": {
            "type": "number",
            "title": "Elapsed Seconds"
          },
          "bean_temperature": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Bean Temperature"
          },
          "environment_temperature": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Environment Temperature"
          },
          "power_percent": {
            "anyOf": [
              {
                "type": "number",
                "maximum": 100.0,
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Power Percent"
          },
          "airflow_percent": {
            "anyOf": [
              {
                "type": "number",
                "maximum": 100.0,
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Airflow Percent"
          },
          "drum_speed_rpm": {
            "anyOf": [
              {
                "type": "number",
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Drum Speed Rpm"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "elapsed_seconds"
        ],
        "title": "Sample"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}
